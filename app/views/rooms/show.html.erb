<div class="container mt-5">
  <%# 相手の名前を表示 %>
  <h2 class="text-center text-primary mb-4">
    <%= @entries.where.not(user_id: current_user.id).first.user.name %>さんとのトークルーム
  </h2>

  <%# メッセージ表示エリア %>
  <div class="row justify-content-center">
    <div class="col-md-8 card p-4 shadow-sm" style="min-height: 400px; background-color: rgba(255, 255, 255, 0.9);">
      <% if @messages.any? %>
        <% @messages.each do |m| %>
          <div class="mb-3 d-flex <%= m.user == current_user ? 'justify-content-end' : 'justify-content-start' %>">
            <div class="p-2 rounded-lg" style="max-width: 70%; <%= m.user == current_user ? 'background-color: #dcf8c6;' : 'background-color: #fce4ec;' %>">
              <%= m.message %>
            </div>
          </div>
        <% end %>
      <% else %>
        <p class="text-center text-muted">メッセージはまだありません</p>
      <% end %>
    </div>
  </div>

  <%# 投稿フォーム（画面下部） %>
  <div class="row justify-content-center mt-4">
    <div class="col-md-8">
      <%= form_with model: @message, local: true, class: "d-flex" do |f| %>
        <%= f.text_field :message, placeholder: "メッセージを入力して下さい", class: "form-control mr-2", maxlength: 140 %>
        <%= f.hidden_field :room_id, value: @room.id %>
        <%= f.submit "送信する", class: "btn btn-success" %>
      <% end %>
    </div>
  </div>
</div>